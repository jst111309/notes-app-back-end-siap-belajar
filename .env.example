NODE_ENV=development
PORT=3000
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=ubah_password_postgres
PGDATABASE=notesapp
# Untuk migration, sesuaikan URL dengan database lokal:
DATABASE_URL=postgres://postgres:ubah_password_postgres@localhost:5432/notesapp
# Untuk RDS: gunakan konfigurasi SSL/TLS sesuai panduan AWS dan network security group
ACCESS_TOKEN_KEY=
REFRESH_TOKEN_KEY=
