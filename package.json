{
  "name": "notes-app-back-end",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Proyek latihan Notes API Express PostgreSQL - rekonstruksi mandiri dari materi belajar",
  "scripts": {
    "start": "node src/server.js",
    "start-dev": "node --watch src/server.js",
    "migrate": "dotenv -e .env -- node-pg-migrate --migrations-dir migrations",
    "check": "node scripts/check-syntax.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "nanoid": "^5.0.9",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "node-pg-migrate": "^7.9.1"
  }
}
